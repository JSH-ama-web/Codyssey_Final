# Copy to .env locally or set in Vercel > Project > Settings > Environment Variables.
# Never commit real secrets.

# ── 필수 ─────────────────────────────────────────────
# 코디세이 콘솔(https://copa.codyssey.kr)에서 발급한 키
AI_API_KEY=

# ── 선택 ─────────────────────────────────────────────
# Gateway 주소 / 모델 (콘솔에 안내된 값으로)
AI_BASE_URL=https://copa.codyssey.kr
AI_MODEL=claude-haiku-4
# 비우면 Anthropic 형식 → 404/405 시 OpenAI 호환 형식 자동 전환. anthropic / openai 로 고정 가능
AI_API_FORMAT=
AI_MAX_TOKENS=1200
AI_TIMEOUT=40

# 로컬 SQLite 경로 (Vercel에서는 비워두면 /tmp/geosoil.sqlite3 사용)
DATABASE_PATH=./geosoil.sqlite3
